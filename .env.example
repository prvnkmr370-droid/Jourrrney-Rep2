PORT=4000
# Change this to a long random string before using this for anything real —
# it signs every session token. The default in code is a dev-only fallback.
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Powers POST /plan-trip/ai, /plan-trip/route-info, and /plan-trip/parse-
# intent (src/routes/planTrip.js) — AI-generated trip itineraries,
# door-to-door route breakdowns, and fuzzy chat-message understanding.
# These three keys are tried IN THIS ORDER (see buildProviderChain in
# planTrip.js) — Claude first, then Gemini, then Groq — and each is
# skipped automatically if unset, so configuring just ONE of the three is
# enough to get AI features working; all three is just extra resilience
# against any single provider's outage/quota. Leave all three unset and
# every route responds 503; the app already falls back to its local
# rule-based planner (generateItinerary() in
# journey-app/src/screens/PlanTrip/data.ts), local name-matcher, and local
# geocode-based route estimate (localRouteEstimate.ts) whenever these
# routes are unavailable, so AI is additive, not required for the app to
# work.

# Claude (Anthropic) — get a key at https://console.anthropic.com (sign
# in, then Settings > API Keys > Create Key; a card is needed to add
# credit, no free tier here unlike the other two). Supports both text and
# photo (vision) requests.
ANTHROPIC_API_KEY=

# Gemini (Google) — get a key at https://ai.google.dev (Google AI Studio),
# sign in with any Google account, no card required for the free tier.
# Supports both text and photo (vision) requests.
GEMINI_API_KEY=

# Groq (console.groq.com — the fast-inference company, unrelated to xAI's
# "Grok" chatbot) — get a key at https://console.groq.com (free, no card
# required). Text-only — Groq's free tier has no vision model verified
# reliable enough for the photo-intent case, so it's skipped automatically
# for photo requests regardless of whether it's configured.
GROQ_API_KEY=

# Not yet integrated, but the provider chain in planTrip.js is built so
# adding another one (e.g. xAI's Grok via https://x.ai/api) is just a new
# callXJson() function plus one entry in buildProviderChain — no other
# code needs to change.

# --- Email sign-in codes (src/lib/mailer.js) --------------------------------
# Set ONE API key plus EMAIL_FROM to have the 6-digit code emailed to the
# address the user typed. Leave all three unset for local development: the
# code is then logged here and returned to the app as `devCode`.
# (Render's free tier blocks SMTP, so both options are HTTPS APIs.)
#
# Resend — https://resend.com (3,000/month free). Until you verify a domain,
# Resend only delivers to your own account's email address.
RESEND_API_KEY=
# Brevo — https://brevo.com (300/day free). The sender must be verified; a
# domain you own gives the best inbox placement.
BREVO_API_KEY=
# Must be an address verified with the provider above.
EMAIL_FROM=Jourrrney <login@yourdomain.com>

# --- Sign in with Facebook (src/routes/facebookAuth.js) ----------------------
# From https://developers.facebook.com : create an app (type "Consumer"), add
# the "Facebook Login" product, and under Facebook Login > Settings add this
# to "Valid OAuth Redirect URIs":
#     <PUBLIC_BASE_URL>/auth/facebook/callback
# The App ID is public; the App Secret must only ever live here (or in the
# Render dashboard), never in the app or in chat. With either left empty the
# Facebook button in the app says it isn't available yet.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# The address this server is reached at (no trailing slash). Must match the
# redirect URI above.
PUBLIC_BASE_URL=https://jourrrney-backend.onrender.com
# The app's link scheme (app.json "scheme"); the callback page opens
# <scheme>://auth?code=... to hand the person back to the app.
APP_SCHEME=journeyapp
# Shown on the data-deletion page Meta requires before an app can go Live.
SUPPORT_EMAIL=
