PORT=4000
# Change this to a long random string before using this for anything real —
# it signs every session token. The default in code is a dev-only fallback.
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Powers POST /plan-trip/ai and /plan-trip/parse-intent (src/routes/
# planTrip.js) — AI-generated trip itineraries and fuzzy chat-message
# understanding via Google's Gemini API, which has a genuinely free tier.
# Get a key at https://ai.google.dev (Google AI Studio) — sign in with any
# Google account, no card required for the free tier. Leave unset and both
# endpoints respond 503; the app already falls back to its local rule-based
# planner (generateItinerary() in journey-app/src/screens/PlanTrip/data.ts)
# and local name-matcher whenever these routes are unavailable, so AI
# planning is additive, not required for the app to work.
GEMINI_API_KEY=

# Failsafe for the two routes above (text-only requests, not the photo
# case) — on a Gemini failure (free-tier "high demand" 503, timeout,
# quota), the same request is retried against Groq's free tier instead of
# giving up straight to the local fallback. Get a key at
# https://console.groq.com (free, no card required). Also optional — leave
# unset and a Gemini failure just falls straight to the local planner/
# matcher as before, same as if this whole file didn't exist.
GROQ_API_KEY=
