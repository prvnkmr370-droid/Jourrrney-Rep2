PORT=4000
# Change this to a long random string before using this for anything real —
# it signs every session token. The default in code is a dev-only fallback.
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Powers POST /plan-trip/ai (src/routes/planTrip.js) — AI-generated trip
# itineraries via Google's Gemini API, which has a genuinely free tier.
# Get a key at https://ai.google.dev (Google AI Studio) — sign in with any
# Google account, no card required for the free tier. Leave unset and the
# endpoint responds 503; the app already falls back to its local rule-based
# planner (generateItinerary() in journey-app/src/screens/PlanTrip/data.ts)
# whenever this route is unavailable, so AI planning is additive, not
# required for the app to work.
GEMINI_API_KEY=
